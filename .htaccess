# App-Dateien beim Server rueckfragen lassen, statt sie blind aus dem
# Browser-Cache zu nehmen. Sonst zeigt der Browser nach einem Update noch
# die alte Fassung an (z. B. eine veraltete Versionsnummer in den Credits),
# obwohl auf dem Server bereits die neue Datei liegt.
#
# "no-cache" heisst nicht "nicht speichern": Der Browser darf die Datei
# behalten, muss aber vor der Verwendung kurz nachfragen. Hat sich nichts
# geaendert, antwortet der Server mit 304 (nicht neu uebertragen) - das
# kostet also kaum etwas.
#
# Make browsers revalidate the app files instead of serving them straight
# from cache, so an update is picked up immediately. "no-cache" still
# allows storing; the browser just has to check, and gets a cheap 304 if
# nothing changed.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Sicherheits-Header / security headers.
  # Schuetzen vor Clickjacking (Einbetten der Login-Seite in fremde iframes),
  # MIME-Sniffing und dem Verraten der Herkunfts-URL an fremde Seiten.
  # Kein CSP-Header: die App nutzt bewusst Inline-Skripte/-Styles und Data-URIs,
  # ein striktes CSP wuerde sie lahmlegen.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Die Kataloge aus den Regelwerken sind gross (pdfdata-craft.js allein rund
# 1,5 MB). Als Text lassen sie sich hervorragend komprimieren - gzip drueckt
# sie auf etwa ein Fuenftel. Ohne diesen Block uebertraegt Apache sie roh.
#
# The rulebook catalogs are large (pdfdata-craft.js alone is about 1.5 MB).
# Being plain text they compress very well - gzip cuts them to roughly a
# fifth. Without this block Apache would send them uncompressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>
