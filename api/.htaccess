# Pass the Authorization header through to PHP. With PHP-FPM/FastCGI/CGI
# Apache strips it by default, which makes every authenticated request fail
# with "Not logged in" even though signing in itself worked.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
