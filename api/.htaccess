# Authorization-Header an PHP durchreichen.
# Apache liefert ihn bei PHP-FPM/FastCGI/CGI sonst nicht an PHP aus –
# dann schlaegt jede angemeldete Anfrage fehl ("Not logged in"), obwohl
# die Anmeldung selbst funktioniert hat.
#
# Pass the Authorization header through to PHP. With PHP-FPM/FastCGI/CGI
# Apache strips it by default, which makes every authenticated request
# fail even though signing in worked.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
