# The API's runtime data (the users' SQLite database) - never commit this.
api/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Battle maps and token pictures belonging to the play groups. User data,
# so not in the repository - and NOT in the MariaDB dump either, which is
# why they get a backup of their own.
api/vtt/

# Each installation's credentials (the database password). It survives an
# update and must never reach the repository.
api/config.local.php

# Operating system litter
Thumbs.db
Desktop.ini
.DS_Store

# Lokale Werkzeug-Konfiguration (Vorschau-Server o. ae.)
.claude/

# Python-Zwischendateien der Extraktionsskripte
__pycache__/
*.pyc
